# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Wallet seed phrase (24 words, space-separated)
STORM_SEED=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24

# ED25519 private key for signing orders (hex-encoded, 64 bytes)
# Generate with: go run ./cmd/example keygen
STORM_PRIVATE_KEY=

# Wallet version: v3r2, v4r2 (default), v5r1
# STORM_WALLET_VERSION=v4r2

# Subwallet ID (optional, default depends on version)
# STORM_SUBWALLET_ID=0
